<?xml version="1.0" encoding="utf-8"?>
<!--
  One window per file (documentLaunchMode intoExisting): opening a file that is already shown brings its
  window forward. The file manager's quick view (ACTION_QUICK_VIEW) hands over the folder's other files as
  clip items, which the previous and next buttons step through. ACTION_EDIT of image/png is what the share
  sheet's Edit button sends (config_preferredSystemImageEditor).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pcviewer">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@style/Theme.PcViewer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:documentLaunchMode="intoExisting"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="680dp"
                android:minWidth="600dp"
                android:minHeight="352dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.QUICK_VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Only images are edited here (rotate and save); text goes to the text editor. -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
