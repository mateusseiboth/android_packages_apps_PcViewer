// PcViewer: "Viewer", the image, PDF and text viewer of LineageOS for PCs. The viewer's logic lives in
// core/ and is tested on the host.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library {
    name: "PcViewerCore",
    host_supported: true,
    srcs: ["core/src/**/*.kt"],
    sdk_version: "core_current",
}

java_test_host {
    name: "PcViewerCoreTests",
    srcs: ["core/tests/**/*.kt"],
    static_libs: [
        "PcViewerCore",
        "junit",
    ],
    test_options: {
        unit_test: true,
    },
}

android_app {
    name: "PcViewer",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    product_specific: true,
    static_libs: [
        "PcViewerCore",
        // Text decoding (encoding and line break detection) is shared with the text editor.
        "PcTextEditorCore",
        "androidx.activity_activity",
        "androidx.activity_activity-compose",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.animation_animation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "kotlinx_coroutines_android",
        // Keeps a photo's EXIF data when an edited copy is saved.
        "androidx.exifinterface_exifinterface",
        // Prints images (PrintHelper); PDFs and text use our own print adapters.
        "androidx.print_print",
    ],
    optimize: {
        optimize: true,
        shrink_resources: true,
    },
}
